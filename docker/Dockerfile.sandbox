# Sandbox image the agent's patches and tests actually run in.
#
# Design intent: this container never gets a bind mount into the host
# filesystem. The target repo is copied in over the Docker API (docker cp),
# so anything that happens here -- a bad patch, an infinite loop, `rm -rf`,
# whatever the coder agent generates -- is contained. Combine with, at
# container-run time: network_disabled=True, mem/cpu/pids limits, and
# non-root user (all set in tools/sandbox.py).
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        patch \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pytest

# Unprivileged user the sandbox runs as. Root is only used briefly (by
# tools/sandbox.py) to chown files copied in from the host before handing
# control back to this user.
RUN useradd --create-home --uid 1000 sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace

WORKDIR /workspace
USER sandbox

CMD ["sleep", "infinity"]

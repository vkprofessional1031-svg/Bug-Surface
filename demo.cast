[1.044, "o", "\u001b[31A\r\u001b[95P\u001b[10C<span class=\"mono\" style=\"color:var(--text-dim)\">${result.attempts} attempt(s)</span>\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m<\u001b[27m/\u001b[27md\u001b[27mi\u001b[27mv\u001b[27m>\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m$\u001b[27m{\u001b[27mr\u001b[27me\u001b[27ms\u001b[27mu\u001b[27ml\u001b[27mt\u001b[27m.\u001b[27mu\u001b[27ms\u001b[27me\u001b[27md\u001b[27m_\u001b[27mm\u001b[27me\u001b[27mm\u001b[27mo\u001b[27mr\u001b[27my\u001b[27m \u001b[27m?\u001b[27m \u001b[27m`\u001b[27m<\u001b[27md\u001b[27mi\u001b[27mv\u001b[27m \u001b[27mc\u001b[27ml\u001b[27ma\u001b[27ms\u001b[27ms\u001b[27m=\u001b[27m\"\u001b[27mm\u001b[27me\u001b[27mm\u001b[27mo\u001b[27mr\u001b[27my\u001b[27m-\u001b[27mt\u001b[27ma\u001b[27mg\u001b[27m\"\u001b[27m>\u001b[27mi\u001b[27mn\u001b[27mf\u001b[27ml\u001b[27mu\u001b[27me\u001b[27mn\u001b[27mc\u001b[27me\u001b[27md\u001b[27m \u001b[27mb\u001b[27my\u001b[27m \u001b[27ma\u001b[27m \u001b[27mp\u001b[27ma\u001b[27ms\u001b[27mt\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mx\u001b[27m<\u001b[27m/\u001b[27md\u001b[27mi\u001b[27mv\u001b[27m>\u001b[27m`\u001b[27m \u001b[27m:\u001b[27m \u001b[27m\"\u001b[27m\"\u001b[27m}\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m<\u001b[27md\u001b[27mi\u001b[27mv\u001b[27m \u001b[27mc\u001b[27ml\u001b[27ma\u001b[27ms\u001b[27ms\u001b[27m=\u001b[27m\"\u001b[27ms\u001b[27me\u001b[27mc\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m-\u001b[27mt\u001b[27mi\u001b[27mt\u001b[27ml\u001b[27me\u001b[27m\"\u001b[27m>\u001b[27mD\u001b[27mi\u001b[27mf\u001b[27mf\u001b[27m<\u001b[27m/\u001b[27md\u001b[27mi\u001b[27m"]

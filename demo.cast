[166.637, "o", ">....                                                      \r\n\u001b[7m    }\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    repo_label = st.selectbox(\"Target repo\", list(repo_options.keys()))\u001b[27m\u001b[K\r\r\n\u001b[7m    issue_text = st.text_area(\u001b[27m\u001b[K\r\r\n\u001b[7m        \"Issue description\",\u001b[27m\u001b[K\r\r\n\u001b[7m        placeholder=\"e.g. subtract(a, b) returns a + b instead of a - b\",\u001b[27m\u001b[K\r\r\n\u001b[7m    )\u001b[27m\u001b[K\r\r\n\u001b[7m    target_file = st.text_input(\"Target file (relative path)\", placeholder=\"e.g. calculator.py\")\u001b[27m\u001b[K\r\r\n\u001b[7m    test_cmd = st.text_input(\"Test command\", value=\"pytest -q\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m    if st.button(\"Run agent\", type=\"primary\"):\u001b[27m\u001b[K\r\r\n\u001b[7m        if not issue_text or not target_file:\u001b[27m\u001b[K\r\r\n\u001b[7m            st.warning(\"Please fill in the issue description and target file.\")\u001b[27m\u001b[K\r\r\n\u001b[7m        else:\u001b[27m\u001b[K\r\r\n\u001b[7m            with st.spinner(\"Planning, coding, testing, reviewing...\"):\u001b[27m\u001b[K\r\r\n\u001b[7m                result = run_pipeline(\u001b[27m\u001b[K\r\r\n\u001b[7m                    repo_path=repo_options[repo_label],\u001b[27m\u001b[K\r\r\n\u001b[7m    "]

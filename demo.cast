[3.515, "o", "\u001b[7mpython3 - << 'EOF'\u001b[27m\r\r\n\u001b[7mwith open(\"README.md\") as f:\u001b[27m\u001b[K\r\r\n\u001b[7m    content = f.read()\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mmarker = \"## Architecture\"\u001b[27m\u001b[K\r\r\n\u001b[7mdemo_section = \"\"\"## Demo\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mhttps://github.com/user-attachments/assets/01b610da-8ec0-40ae-a503-2abd38c42020\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mThe full pipeline running end-to-end against a 7-issue benchmark: issue in,\u001b[27m\u001b[K\r\r\n\u001b[7mplan produced, code written, tested inside an isolated Docker sandbox,\u001b[27m\u001b[K\r\r\n\u001b[7mreviewed, and a final success-rate summary printed out.\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m\"\"\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mcontent = content.replace(marker, demo_section + marker, 1)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mwith open(\"README.md\", \"w\") as f:\u001b[27m\u001b[K\r\r\n\u001b[7m    f.write(content)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mprint(\"Done\")\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.433, "o", "\u001b[21A\u001b[43C\u001b[27mp\u001b[27my\u001b[27mt\u001b[27mh\u001b[27mo\u001b[27mn\u001b[27m3\u001b[27m \u001b[27m-\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m(\u001b[27m\"\u001b[27mR\u001b[27mE\u001b[27mA\u001b[27mD\u001b[27mM\u001b[27mE\u001b[27m.\u001b[27mm\u001b[27md\u001b[27m\"\u001b[27m)\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27mf\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mt\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m \u001b[27m=\u001b[27m \u001b[27mf\u001b[27m.\u001b[27mr\u001b[27me\u001b[27ma\u001b[27md\u001b[27m(\u001b[27m)\u001b[2B\r\u001b[27mm\u001b[27ma\u001b[27mr\u001b[27mk\u001b[27me\u001b[27mr\u001b[27m \u001b[27m=\u001b[27m \u001b[27m\"\u001b[27m#\u001b[27m#\u001b[27m \u001b[27mA\u001b[27mr\u001b[27mc\u001b[27mh\u001b[27mi\u001b[27mt\u001b[27me\u001b[27mc\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27me\u001b[27m\"\u001b[1B\r\u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27m_\u001b[27ms\u001b[27me\u001b[27mc\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m \u001b[27m=\u001b[27m \u001b[27m\"\u001b[27m\"\u001b[27m\"\u001b[27m#\u001b[27m#\u001b[27m \u001b[27mD\u001b[27me\u001b[27mm\u001b[27mo\u001b[2B\r\u001b[27mh\u001b[27mt\u001b[27mt\u001b[27mp\u001b[27ms\u001b[27m:\u001b[27m/\u001b[27m/\u001b[27mg\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27mu\u001b[27mb\u001b[27m.\u001b[27mc\u001b[27mo\u001b[27mm\u001b[27m/\u001b[27mu\u001b[27ms\u001b[27me\u001b[27mr\u001b[27m-\u001b[27ma\u001b[27mt\u001b[27mt\u001b[27ma\u001b[27mc\u001b[27mh\u001b[27mm\u001b[27me\u001b[27mn\u001b[27mt\u001b[27ms\u001b[27m/\u001b[27ma\u001b[27ms\u001b[27ms\u001b[27me\u001b[27mt\u001b[27ms\u001b[27m/\u001b[27m0\u001b[27m1\u001b[27m"]

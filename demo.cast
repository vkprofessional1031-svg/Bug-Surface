[0.000, "o", " _get_collection()\u001b[27m\u001b[K\r\r\n\u001b[7m        count = collection.count()\u001b[27m\u001b[K\r\r\n\u001b[7m        st.metric(\"Stored fixes\", count)\u001b[27m\u001b[K\r\r\n\u001b[7m        if count > 0:\u001b[27m\u001b[K\r\r\n\u001b[7m            all_items = collection.get()\u001b[27m\u001b[K\r\r\n\u001b[7m            for i, (doc_id, meta) in enumerate(zip(all_items[\"ids\"], all_items[\"metadatas\"])):\u001b[27m\u001b[K\r\r\n\u001b[7m                with st.expander(f\"{doc_id}\"):\u001b[27m\u001b[K\r\r\n\u001b[7m                    st.write(\"**Issue:**\", meta[\"issue_text\"])\u001b[27m\u001b[K\r\r\n\u001b[7m                    st.write(\"**Review notes:**\", meta[\"review_reasoning\"])\u001b[27m\u001b[K\r\r\n\u001b[7m        else:\u001b[27m\u001b[K\r\r\n\u001b[7m            st.info(\"No fixes stored yet. Run the benchmark or a live issue first.\")\u001b[27m\u001b[K\r\r\n\u001b[7m    except Exception as e:\u001b[27m\u001b[K\r\r\n\u001b[7m        st.warning(f\"Could not load memory store: {e}\")\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[1.280, "o", "\u001b[30A\r\u001b[33P\u001b[12Cif result[\"success\"]:\u001b[39C\u001b[K\u001b[1B\r\u001b[74P\u001b[16Cst.success(f\"✅ Fixed in {result['attempts']} attempt(s)\")\u001b[K\u001b[1B\r\u001b[45P\u001b[16Cif result.get(\"used_memory\"):\u001b[15C\u001b[K\u001b[1B\r\u001b[77P\u001b[20Cst.info(\"\u001b[7m<0001f9e0>\u001b[27m Used memory from a similar past fix\")\u001b[K\u001b[1B\r\u001b[36P\u001b[16Cst.subheader(\"Plan\")\u001b[33C\u001b[K\u001b[1B\r\u001b[52P\u001b[16Cst.json(result[\"plan\"].model_dump())\u001b[K\u001b[1B\r\u001b[36P\u001b[16Cst.subheader(\"Diff\")\u001b[33C\u001b[K\u001b[1B\r\u001b[56P\u001b[16Cst.code(result[\"diff\"], language=\"diff\")\u001b[K\u001b[1B\r\u001b[48P\u001b[16Cst.subheader(\"Review reasoning\")\u001b[9C\u001b[K\u001b[1B\r\u001b[52P\u001b[16Cst.write(result[\"review\"].reasoning)\u001b[K\u001b[1B\r\u001b[17P\u001b[12Celse:\u001b[71C\u001b[K\u001b[1B\r\u001b[74P\u001b[16Cst.error(f\"❌ Failed after {result['attempts']} attempts\")\u001b[K\u001b[1B\r\u001b[M\u001b[16Cst.text(result[\"last_feedback\"])\u001b[1B\r\u001b[K\u001b[1B\u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mt\u001b[27ma\u001b[27mb\u001b[27m3\u001b[27m:\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ms\u001b[27mt\u001b[27m.\u001b[27mheader(\"Memory Store\")\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mt\u001b[27mr\u001b[27my\u001b[27m:\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mc\u001b[27mo\u001b[27ml\u001b[27ml\u001b[27me\u001b[27mc\u001b[27mt\u001b[27mi\u001b[27"]
[0.000, "o", "mo\u001b[27mn\u001b[27m \u001b[27m=\u001b[27m \u001b[27m_\u001b[27mg\u001b[27me\u001b[27mt\u001b[27m_\u001b[27mc\u001b[27mo\u001b[27ml\u001b[27ml\u001b[27me\u001b[27mc\u001b[27mt\u001b[27mion()\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mc\u001b[27mo\u001b[27mu\u001b[27mn\u001b[27mt\u001b[27m \u001b[27m=\u001b[27m \u001b[27mc\u001b[27mo\u001b[27ml\u001b[27ml\u001b[27me\u001b[27mc\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m.\u001b[27mc\u001b[27mo\u001b[27mu\u001b[27mn\u001b[27mt\u001b[27m(\u001b[27m)\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ms\u001b[27mt\u001b[27m.\u001b[27mm\u001b[27me\u001b[27mt\u001b[27mr\u001b[27mi\u001b[27mc\u001b[27m(\u001b[27m\"\u001b[27mS\u001b[27mtored fixes\", count)\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27mc\u001b[27mo\u001b[27mu\u001b[27mn\u001b[27mt\u001b[27m \u001b[27m>\u001b[27m \u001b[27m0\u001b[27m:\u001b[K\u001b[1B\r\u001b[94P\u001b[11C all_items = collection.get()\u001b[K\u001b[1B\r\u001b[46P\u001b[12Cfor i, (doc_id, meta) in enumerate(zip(all_items[\"ids\"], all_items[\"metadatas\"])):\u001b[K\u001b[1B\r\u001b[62P\u001b[16Cwith st.expander(f\"{doc_id}\"):\u001b[K\u001b[1B\r\u001b[75P\u001b[20Cst.write(\"**Issue:**\", meta[\"issue_text\"])\u001b[K\u001b[1B\r\u001b[13P\u001b[20Cst.write(\"**Review notes:**\", meta[\"review_reasoning\"])\u001b[17C\u001b[K\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27me\u001b[27ml\u001b[27ms\u001b[27me\u001b[27m:\u001b[K\u001b"]

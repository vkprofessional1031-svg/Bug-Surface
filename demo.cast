[0.177, "o", "\u001b[A\u001b[38C\u001b[27mL\u001b[27me\u001b[27mt\u001b[27m'\u001b[27ms\u001b[27m \u001b[27ms\u001b[27me\u001b[27me\u001b[27m \u001b[27mw\u001b[27mh\u001b[27me\u001b[27mr\u001b[27me\u001b[27m \u001b[27mt\u001b[27mo\u001b[27m \u001b[27mp\u001b[27ml\u001b[27ma\u001b[27mc\u001b[27me\u001b[27m \u001b[27mi\u001b[27mt\u001b[27m \u001b[27m—\u001b[27m \u001b[27mc\u001b[27mh\u001b[27me\u001b[27mc\u001b[27mk\u001b[27m \u001b[27mt\u001b[27mh\u001b[27me\u001b[27m \u001b[27mc\u001b[27mu\u001b[27mr\u001b[27mr\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m \u001b[27mt\u001b[27mo\u001b[27mp\u001b[27m \u001b[27mo\u001b[27mf\u001b[27m \u001b[27my\u001b[27mo\u001b[27mu\u001b[27mr \u001b[27mR\u001b[27mE\u001b[27mA\u001b[27mD\u001b[27mM\u001b[27mE\u001b[27m:"]

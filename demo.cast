[16.625, "o", ">....                                                      \r\n\u001b[7m        for doc_id, meta in zip(all_items[\"ids\"], all_items[\"metadatas\"])\u001b[27m\u001b[K\r\r\n\u001b[7m    ]\u001b[27m\u001b[K\r\r\n\u001b[7m    return {\"count\": count, \"items\": items}\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m@app.post(\"/api/run\")\u001b[27m\u001b[K\r\r\n\u001b[7mdef run_agent(req: RunRequest):\u001b[27m\u001b[K\r\r\n\u001b[7m    result = run_pipeline(\u001b[27m\u001b[K\r\r\n\u001b[7m        repo_path=req.repo_path,\u001b[27m\u001b[K\r\r\n\u001b[7m        issue_text=req.issue_text,\u001b[27m\u001b[K\r\r\n\u001b[7m        target_files=[req.target_file],\u001b[27m\u001b[K\r\r\n\u001b[7m        issue_name=f\"live_run_{hash(req.issue_text) % 10000}\",\u001b[27m\u001b[K\r\r\n\u001b[7m        test_cmd=req.test_cmd,\u001b[27m\u001b[K\r\r\n\u001b[7m    )\u001b[27m\u001b[K\r\r\n\u001b[7m    if result[\"success\"]:\u001b[27m\u001b[K\r\r\n\u001b[7m        return {\u001b[27m\u001b[K\r\r\n\u001b[7m            \"success\": True,\u001b[27m\u001b[K\r\r\n\u001b[7m            \"attempts\": result[\"attempts\"],\u001b[27m\u001b[K\r\r\n\u001b[7m            \"diff\": result[\"diff\"],\u001b[27m\u001b[K\r\r\n\u001b[7m            \"plan\": result[\"plan\"].model_dump(),\u001b[27m\u001b[K\r\r\n\u001b[7m            \"review_reasoning\": result[\"review\"].reasoning,\u001b[27m\u001b[K\r\r\n\u001b[7m       "]

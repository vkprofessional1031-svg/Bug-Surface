[0.000, "o", "r\u001b[27m \u001b[27ms\u001b[27ma\u001b[27mn\u001b[27md\u001b[27mb\u001b[27mo\u001b[27mx\u001b[27m,\u001b[1B\r\u001b[27mr\u001b[27me\u001b[27mv\u001b[27mi\u001b[27me\u001b[27mw\u001b[27me\u001b[27md\u001b[27m,\u001b[27m \u001b[27ma\u001b[27mn\u001b[27md\u001b[27m \u001b[27ma\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mn\u001b[27ma\u001b[27ml\u001b[27m \u001b[27ms\u001b[27mu\u001b[27mc\u001b[27mc\u001b[27me\u001b[27ms\u001b[27ms\u001b[27m-\u001b[27mr\u001b[27ma\u001b[27mt\u001b[27me\u001b[27m \u001b[27ms\u001b[27mu\u001b[27mm\u001b[27mm\u001b[27ma\u001b[27mr\u001b[27my\u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mn\u001b[27mt\u001b[27me\u001b[27md\u001b[27m \u001b[27mo\u001b[27mu\u001b[27mt\u001b[27m.\u001b[2B\r\u001b[27m\"\u001b[27m\"\u001b[27m\"\u001b[2B\r\u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mt\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m \u001b[27m=\u001b[27m \u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mt\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m.\u001b[27mr\u001b[27me\u001b[27mp\u001b[27ml\u001b[27ma\u001b[27mc\u001b[27me\u001b[27m(\u001b[27mm\u001b[27ma\u001b[27mr\u001b[27mk\u001b[27me\u001b[27mr\u001b[27m,\u001b[27m \u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27m_\u001b[27ms\u001b[27me\u001b[27mc\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m \u001b[27m+\u001b[27m \u001b[27mm\u001b[27ma\u001b[27mr\u001b[27mk\u001b[27me\u001b[27mr\u001b[27m,\u001b[27m \u001b[27m1\u001b[27m)\u001b[2B\r\u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m(\u001b[27m\"\u001b[27mR\u001b[27mE\u001b[27mA\u001b[27mD\u001b[27mM\u001b[27mE\u001b[27m.\u001b[27mm\u001b[27md\u001b[27m\"\u001b[27m,\u001b[27m \u001b[27m\"\u001b[27mw\u001b[27m\"\u001b[27m)\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27mf\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27m.\u001b[27mw\u001b["]
